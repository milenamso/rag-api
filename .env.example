# Copy to .env and fill in. Every app setting uses the RAG_ prefix (see app/config.py).

# Claude API key (read directly by the Anthropic SDK)
ANTHROPIC_API_KEY=

# LLM: "anthropic" (Claude) or "extractive" (offline, no LLM)
RAG_LLM_PROVIDER=anthropic
RAG_ANTHROPIC_MODEL=claude-opus-5-5
RAG_ANTHROPIC_EFFORT=medium
RAG_ANTHROPIC_SERVER_FALLBACK=true

# Vector store: "persistent" (local folder), "http" (Chroma server) or "memory"
RAG_CHROMA_MODE=persistent
RAG_CHROMA_PATH=./data/chroma
RAG_CHROMA_HOST=localhost
RAG_CHROMA_PORT=8000

# Embeddings: "default" (local ONNX MiniLM) or "hash" (lightweight, for tests/demos)
RAG_EMBEDDING_PROVIDER=default
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_MAX_UPLOAD_MB=20

# Semantic cache
RAG_CACHE_ENABLED=true
RAG_CACHE_SIMILARITY_THRESHOLD=0.92
RAG_CACHE_TTL_SECONDS=3600

# Logging
RAG_LOG_LEVEL=INFO
RAG_LOG_JSON=true
